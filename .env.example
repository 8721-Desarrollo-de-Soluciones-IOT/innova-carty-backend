# Copy these variables to Render (Environment). Never commit the real values.

# Supabase > Connect > Session pooler (IPv4). Use jdbc:postgresql:// and put user and password apart.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<database password>

# Any long random text (at least 32 characters)
JWT_SECRET=<random secret>

# Key the ESP32 sends in the X-Device-Key header
DEVICE_API_KEY=<device key>

# Shared secret of the payment webhook (header X-Webhook-Secret)
PAYMENT_WEBHOOK_SECRET=<webhook secret>
